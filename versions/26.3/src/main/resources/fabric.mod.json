{
  "schemaVersion": 1,
  "id": "remember_that_message",
  "version": "${version}",
  "name": "Remember that Message",
  "description": "Persistent public chat and game-event history, replayed when players join.",
  "authors": [
    "IceeAn"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.iceean.rememberthatmessage.RememberThatMessageMod"
    ],
    "client": [
      "dev.iceean.rememberthatmessage.client.HistoryClient"
    ],
    "modmenu": [
      "dev.iceean.rememberthatmessage.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "remember_that_message.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "remember_that_message.heads.mixins.json",
      "environment": "client"
    },
    {
      "config": "remember_that_message.chattools.mixins.json",
      "environment": "client"
    },
    {
      "config": "remember_that_message.common.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=0.165.0+26.3",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "chatpatches": "*",
    "chattools": "*",
    "chat_heads": "*"
  }
}
