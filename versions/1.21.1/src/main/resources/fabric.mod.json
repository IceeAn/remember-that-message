{
  "schemaVersion": 1,
  "id": "server_chat_history",
  "version": "${version}",
  "name": "Server Chat History",
  "description": "Persistent public chat and game-event history, replayed when players join.",
  "authors": [
    "IceeAn"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.iceean.serverchathistory.ServerChatHistoryMod"
    ],
    "client": [
      "io.github.iceean.serverchathistory.client.HistoryClient"
    ],
    "modmenu": [
      "io.github.iceean.serverchathistory.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "server_chat_history.common.mixins.json",
    {
      "config": "server_chat_history.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "server_chat_history.heads.mixins.json",
      "environment": "client"
    },
    {
      "config": "server_chat_history.chattools.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=0.116.17+1.21.1",
    "minecraft": "1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*",
    "chatpatches": "*",
    "chattools": "*",
    "chat_heads": "*"
  }
}
